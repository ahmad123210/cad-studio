{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.cadstudio.desktop",
  "productName": "CAD Studio",
  "copyright": "Copyright © 2026 CAD Studio",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CAD Studio",
    "artifactName": "CAD-Studio-Setup-${version}.${ext}",
    "perMachine": false
  },
  "portable": {
    "artifactName": "CAD-Studio-${version}-portable.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ahmad123210",
      "repo": "cad-studio",
      "releaseType": "release"
    }
  ],
  "compression": "normal",
  "fileAssociations": [
    {
      "ext": "cadproj",
      "name": "CAD Studio Project",
      "description": "CAD Studio Project",
      "role": "Editor",
      "icon": "build/icon.ico"
    }
  ]
}
