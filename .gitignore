# ── الاعتماديات ──
node_modules/

# ── مخرجات البناء ──
# مجلد build/ يحوي موارد أيقونة ويندوز لـ electron-builder فقط، وما عداها يُتجاهل
**/build/*
!/build/icon.ico
!/build/icon.png
dist/
dist-electron/
release/
server.js
*.tsbuildinfo
coverage/

# ── Android / Capacitor (عند إضافتها لاحقاً) ──
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/app/release/
*.keystore
*.jks

# ── الأسرار والإعدادات المحلية (لا ترفع مفاتيح Gemini أبداً) ──
.env*
!.env.example

# ── ملفات النظام والمحررات ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── السجلات ──
*.log
npm-debug.log*

# ── مخرجات الاختبارات ──
test-results/
playwright-report/
blob-report/
