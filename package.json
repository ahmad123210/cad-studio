{
  "name": "cad-studio",
  "description": "منصة التصميم الهندسي والمعماري والكهروميكانيكي الاحترافية (Professional Architectural & MEP 2D CAD Platform)",
  "author": "Ahmad Khaled Natour -Knatoura@gmail.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "npm run build && tsx server.ts --production",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "electron:start": "electron .",
    "build:win": "vite build && electron-builder --win --config electron-builder.json",
    "build:win:portable": "vite build && electron-builder --win portable --config electron-builder.json",
    "build:win:fast": "vite build && electron-builder --win --dir --config electron-builder.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "konva": "^10.7.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
